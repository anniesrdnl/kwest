# Copy to .env.local and fill in. Values come from Supabase:
# Project Settings → API Keys (publishable key) and the project URL.
# These are PUBLIC values. Never put the secret / service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
